# NewPower — iOS CocoaPods integration.
#
# 15.0 rather than Flutter's stock 12.0/13.0: `google_maps_flutter_ios` 2.18.4
# declares `s.platform = :ios, '14.0'`, so a lower target makes `pod install`
# refuse to resolve. 15.0 is one step above that floor and matches where the
# Firebase pods are heading, so the next firebase_core bump does not force
# this file open again.
#
# Keep in step with IPHONEOS_DEPLOYMENT_TARGET in Runner.xcodeproj and with
# MinimumOSVersion in Flutter/AppFrameworkInfo.plist.
platform :ios, '15.0'

# CocoaPods analytics sends network stats synchronously, which slows builds.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))

  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)

    target.build_configurations.each do |config|
      # Several pods still ship an 11.0/12.0 default. Without this they build
      # against a lower target than the app and Xcode 15+ emits a hard error
      # for the mismatch on archive.
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'

      # geolocator, image_picker and record each compile in every permission
      # the plugin *can* request unless told otherwise. This app asks for
      # location-when-in-use, camera, photo library and microphone — and
      # nothing else. Compiling out the rest keeps App Review from asking
      # why a binary references APIs whose usage strings are absent from
      # Info.plist, which is a common rejection.
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        'PERMISSION_LOCATION=1',
        'PERMISSION_CAMERA=1',
        'PERMISSION_PHOTOS=1',
        'PERMISSION_MICROPHONE=1',
      ]
    end
  end
end
