<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
	<dict>
		<key>CFBundleDevelopmentRegion</key>
		<string>$(DEVELOPMENT_LANGUAGE)</string>
		<key>CFBundleDisplayName</key>
		<string>NewPower</string>
		<key>CFBundleExecutable</key>
		<string>$(EXECUTABLE_NAME)</string>
		<key>CFBundleIdentifier</key>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
		<key>CFBundleInfoDictionaryVersion</key>
		<string>6.0</string>
		<key>CFBundleName</key>
		<string>NewPower</string>
		<key>CFBundlePackageType</key>
		<string>APPL</string>
		<key>CFBundleShortVersionString</key>
		<string>$(FLUTTER_BUILD_NAME)</string>
		<key>CFBundleSignature</key>
		<string>????</string>
		<key>CFBundleVersion</key>
		<string>$(FLUTTER_BUILD_NUMBER)</string>
		<key>LSRequiresIPhoneOS</key>
		<true/>
		<key>UILaunchStoryboardName</key>
		<string>LaunchScreen</string>
		<key>UIMainStoryboardFile</key>
		<string>Main</string>
		<key>UISupportedInterfaceOrientations</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>UISupportedInterfaceOrientations~ipad</key>
		<array>
			<string>UIInterfaceOrientationPortrait</string>
			<string>UIInterfaceOrientationPortraitUpsideDown</string>
			<string>UIInterfaceOrientationLandscapeLeft</string>
			<string>UIInterfaceOrientationLandscapeRight</string>
		</array>
		<key>CADisableMinimumFrameDurationOnPhone</key>
		<true/>
		<key>UIApplicationSupportsIndirectInputEvents</key>
		<true/>
		<key>UIStatusBarHidden</key>
		<false/>
		<key>NSLocationWhenInUseUsageDescription</key>
		<string>NewPower uses your location to pin the building you're registering and to record where a visit took place.</string>
		<key>NSCameraUsageDescription</key>
		<string>NewPower uses your camera to photograph the building and site visits.</string>
		<key>NSPhotoLibraryUsageDescription</key>
		<string>NewPower needs access to your photo library to attach existing photos to a project.</string>
		<key>NSMicrophoneUsageDescription</key>
		<string>NewPower uses your microphone to record voice notes on a visit or call.</string>
		<!-- Export compliance. NewPower uses only HTTPS/TLS and the platform
		     keychain — both are exempt under category 5, part 2 of the US
		     Export Administration Regulations, and neither is proprietary
		     cryptography.

		     Declaring it here rather than in App Store Connect is what stops
		     every single TestFlight and App Store upload from stalling on the
		     "Does your app use encryption?" question before it can be
		     distributed. -->
		<key>ITSAppUsesNonExemptEncryption</key>
		<false/>
		<!-- Languages the app actually ships, so the App Store listing shows
		     both instead of inferring English alone from
		     CFBundleDevelopmentRegion. Matches
		     AppLocalizations.supportedLocales. -->
		<key>CFBundleLocalizations</key>
		<array>
			<string>en</string>
			<string>ar</string>
		</array>
		<!-- Lets firebaseBackgroundHandler run for a data message while the
		     app is backgrounded or terminated. Without it iOS delivers only
		     the tray notification and the handler never fires, so the badge
		     and inbox stay stale until the next resume.

		     Xcode writes this when you tick Background Modes → Remote
		     notifications; it is checked in so the requirement is
		     version-controlled rather than living in one machine's Xcode
		     state. -->
		<key>UIBackgroundModes</key>
		<array>
			<string>remote-notification</string>
		</array>
	</dict>
</plist>
