<?xml version="1.0" encoding="utf-8"?>
<!--
  API 31+ replacement for allowBackup/fullBackupContent, which only cover
  API 30 and below. Both are set, and both say the same thing: this app opts
  out of cloud backup and of device-to-device transfer.

  The reason is EncryptedSharedPreferences — see the comment on the
  <application> element in AndroidManifest.xml. Its master key is
  hardware-backed and does not migrate, so restored ciphertext is
  undecryptable and puts the app in an unrecoverable startup-error loop.

  `disableIfNoEncryptionCapabilities` on cloud-backup is required by the
  schema when content is excluded; with a bare <exclude domain="root"/> there
  is nothing left to back up either way.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="false">
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="file" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
